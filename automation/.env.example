# The runner inherits the local PostgreSQL credentials from apps/api/.env and automatically targets a sibling database named marketflow_automation.
# Set DATABASE_URL here only if the isolated automation DB uses different connection details.
# DATABASE_URL=postgresql://YOUR_LOCAL_POSTGRES_USER@localhost:5432/marketflow_automation?schema=public
WEB_BASE_URL=http://127.0.0.1:3100
API_BASE_URL=http://127.0.0.1:4100/api/v1
AUTOMATION_EMAIL=owner@nexora.example
AUTOMATION_PASSWORD=MarketFlow2026!
AUTOMATION_ALLOW_NON_TEST_DATABASE=false
AUTOMATION_WORKERS=5
