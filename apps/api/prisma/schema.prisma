generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceType {
  BUSINESS
  AGENCY
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MARKETING_MANAGER
  SALES_AGENT
  CONTENT_CREATOR
  APPROVER
  ANALYST
  CLIENT_VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  PROPOSAL_PENDING
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  REFERRAL
  LINKEDIN
  GOOGLE
  WHATSAPP
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  phone               String?
  profileImage        String?
  verifiedAt          DateTime?
  createdAt           DateTime             @default(now())
  sessions            Session[]
  memberships         Membership[]
  activities          LeadActivity[]
  assignedLeads       Lead[]               @relation("LeadOwner")
  assignedTasks       Task[]               @relation("TaskOwner")
  comments            TaskComment[]
  invitesSent         Invitation[]         @relation("WorkspaceInviter")
  authChallenges      AuthChallenge[]
  agencyAccessGranted AgencyClientAccess[] @relation("AgencyAccessGrantor")
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuthChallenge {
  id         String    @id @default(cuid())
  userId     String
  kind       String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, expiresAt])
}

model Workspace {
  id             String               @id @default(cuid())
  name           String
  type           WorkspaceType        @default(BUSINESS)
  timezone       String               @default("Asia/Karachi")
  currency       String               @default("PKR")
  createdAt      DateTime             @default(now())
  memberships    Membership[]
  leads          Lead[]
  leadActivities LeadActivity[]
  customers      Customer[]
  deals          Deal[]
  tasks          Task[]
  campaigns      Campaign[]
  contentItems   ContentItem[]
  landingPages   LandingPage[]
  automations    Automation[]
  pipelineStages PipelineStage[]
  attachments    Attachment[]
  taskReminders  TaskReminder[]
  invitations    Invitation[]
  clientGrants   AgencyClientAccess[] @relation("AgencyWorkspace")
  agencyGrants   AgencyClientAccess[] @relation("ClientWorkspace")
  integrations  IntegrationConnection[]
  auditEvents   AuditEvent[]
  subscription  WorkspaceSubscription?
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  description String?
  channel     String         @default("OTHER")
  status      CampaignStatus @default(DRAFT)
  budgetMinor Int            @default(0)
  currency    String         @default("PKR")
  startsAt    DateTime?
  endsAt      DateTime?
  goal        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content     ContentItem[]

  @@index([workspaceId, status, startsAt])
}

model ContentItem {
  id          String        @id @default(cuid())
  workspaceId String
  campaignId  String?
  title       String
  body        String        @default("")
  channel     String        @default("OTHER")
  status      ContentStatus @default(DRAFT)
  publishAt   DateTime?
  mediaUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, publishAt])
}

model LandingPage {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String    @unique
  title       String
  headline    String
  description String    @default("")
  buttonText  String    @default("Send")
  interest    String?
  formFields  Json      @default("[]")
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([isPublished, slug])
}

model Automation {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  trigger     String
  action      String
  actionValue String?
  conditionField String?
  conditionValue String?
  delayMinutes Int @default(0)
  isActive    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        AutomationRun[]

  @@index([workspaceId, trigger, isActive])
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  recordId     String?
  result       String
  status       String     @default("DONE")
  scheduledAt  DateTime?
  claimedAt    DateTime?
  attempts     Int        @default(0)
  lastError    String?
  createdAt    DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
  @@index([status, scheduledAt, claimedAt])
}

model PipelineStage {
  id          String     @id @default(cuid())
  workspaceId String
  key         String
  label       String
  position    Int
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(SALES_AGENT)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  invitedById String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("WorkspaceInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email, acceptedAt])
}

model AgencyClientAccess {
  id                String        @id @default(cuid())
  agencyWorkspaceId String
  clientWorkspaceId String
  grantedById       String
  accessRole        WorkspaceRole @default(CLIENT_VIEWER)
  createdAt         DateTime      @default(now())
  agencyWorkspace   Workspace     @relation("AgencyWorkspace", fields: [agencyWorkspaceId], references: [id], onDelete: Cascade)
  clientWorkspace   Workspace     @relation("ClientWorkspace", fields: [clientWorkspaceId], references: [id], onDelete: Cascade)
  grantedBy         User          @relation("AgencyAccessGrantor", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([agencyWorkspaceId, clientWorkspaceId])
  @@index([clientWorkspaceId])
}

model Lead {
  id           String         @id @default(cuid())
  workspaceId  String
  name         String
  email        String?
  phone        String?
  interest     String?
  source       LeadSource     @default(OTHER)
  status       String         @default("NEW")
  notes        String?
  assignedToId String?
  archivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("LeadOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  tasks        Task[]
  deals        Deal[]
  activities   LeadActivity[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, email])
  @@index([assignedToId])
}

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  company     String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals       Deal[]
  tasks       Task[]

  @@index([workspaceId, name])
}

model LeadActivity {
  id          String    @id @default(cuid())
  workspaceId String
  leadId      String
  userId      String?
  type        String
  message     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, leadId, createdAt])
}

model Deal {
  id          String    @id @default(cuid())
  workspaceId String
  leadId      String?
  customerId  String?
  title       String
  amountMinor Int       @default(0)
  currency    String    @default("PKR")
  stage       String    @default("OPEN")
  expectedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, stage, createdAt])
}

model Task {
  id           String        @id @default(cuid())
  workspaceId  String
  leadId       String?
  customerId   String?
  title        String
  description  String?
  status       TaskStatus    @default(OPEN)
  priority     TaskPriority  @default(MEDIUM)
  dueAt        DateTime?
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  comments     TaskComment[]
  assignedTo   User?         @relation("TaskOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  reminder     TaskReminder?

  @@index([workspaceId, status, dueAt])
  @@index([assignedToId])
}

model TaskReminder {
  id          String    @id @default(cuid())
  workspaceId String
  taskId      String    @unique
  remindAt    DateTime
  sentAt      DateTime?
  claimedAt   DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([sentAt, remindAt])
}

model Attachment {
  id          String    @id @default(cuid())
  workspaceId String
  recordType  String
  recordId    String
  fileName    String
  mimeType    String
  sizeBytes   Int
  content     Bytes
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recordType, recordId, createdAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model IntegrationConnection {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String
  label       String
  webhookKey  String   @unique
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, provider])
  @@index([workspaceId, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entity      String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model WorkspaceSubscription {
  id          String   @id @default(cuid())
  workspaceId String @unique
  plan        String   @default("FREE")
  status      String   @default("ACTIVE")
  periodEnd   DateTime?
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LoginThrottle {
  id        String   @id @default(cuid())
  keyHash   String   @unique
  attempts  Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
  @@index([resetAt])
}
